{
  "version": 2,
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/update-prices",
      "schedule": "15 10 * * 1-5"
    }
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "{app.py,trade_parser.py,backend/**,templates/**,static/**}",
        "excludeFiles": "{.env*,.secret_key*,*.db,*.db-*,*.sqlite*,uploads/**,.venv/**,venv/**,tests/**,supabase/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
