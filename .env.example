# Local development: copy to .env; python-dotenv loads it without overriding exported variables.
# Leave DATABASE_URL empty to keep using the existing local commission.db and uploads/.
COMMISSION_ENV=development
DATABASE_URL=
COMMISSION_DB=commission.db
COMMISSION_UPLOAD_DIR=uploads

# Production: generate a permanent value with: python -c "import secrets; print(secrets.token_hex(32))"
# Required on Vercel and whenever DATABASE_URL is set. Never rotate casually: it signs sessions/receipts.
SECRET_KEY=

# Production requires exactly one server-configured administrator credential (at least 10 characters).
# ADMIN_PASSWORD_HASH accepts a Werkzeug scrypt or PBKDF2-SHA256 hash.
# Local first-run setup is allowed only from loopback when neither is configured.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Supabase -> Connect -> Transaction pooler (port 6543).
# Percent-encode reserved characters in the database password. TLS is enforced by the application.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=commission-evidence

# Recommended for a stable share link and trusted Host validation.
# Use the exact HTTPS production origin, without a path or trailing slash.
PUBLIC_BASE_URL=
# Additional allowed custom/preview hostnames, comma separated; Vercel deployment hosts are included.
TRUSTED_HOSTS=

# Vercel sets VERCEL=1 itself. For another production host, set COMMISSION_ENV=production.
# Do not expose DATABASE_URL, SECRET_KEY, ADMIN_PASSWORD*, or the service-role key in browser code.
